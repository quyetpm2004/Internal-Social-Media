generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum Status {
  ACTIVE
  INACTIVE
}

enum GroupType {
  PUBLIC
  PRIVATE
  DEPARTMENT
}

enum GroupStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum GroupMemberRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum PostVisibility {
  PUBLIC
  PRIVATE
  DEPARTMENT
  GROUP
}

enum PostStatus {
  ACTIVE
  PENDING_REVIEW
  HIDDEN
  DELETED
}

enum PostContentFormat {
  PLAIN
  HTML
}

enum CommentStatus {
  ACTIVE
  HIDDEN
  DELETED
}

enum ReactionType {
  LIKE
  LOVE
  HAHA
  WOW
  SAD
  ANGRY
}

enum AttachmentType {
  IMAGE
  VIDEO
  FILE
}

enum GroupMemberStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum GroupPermission {
  ADMIN_ONLY
  ANY_MEMBER
}

enum MediaStatus {
  PENDING
  READY
  ACTIVE
  FAILED
  DELETED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationMemberRole {
  MEMBER
  ADMIN
}

enum MessageContentType {
  TEXT
  IMAGE
  FILE
  SYSTEM
  POLL
}

enum PollStatus {
  ACTIVE
  CLOSED
}

enum EventAttendanceStatus {
  GOING
  MAYBE
  DECLINED
}

enum MessageStatus {
  ACTIVE
  EDITED
  DELETED
}

enum NotificationType {
  POST_APPROVED
  POST_REJECTED
  POST_PINNED
  POST_UNPINNED
  POST_REACTION
  POST_COMMENT
  COMMENT_REPLY
  COMMENT_REACTION
  GROUP_MEMBER_ADDED
  GROUP_MEMBER_ROLE_CHANGED
  GROUP_MEMBER_STATUS_CHANGED
  GROUP_MEMBER_KICKED
  GROUP_MEMBER_REJECTED
}

model User {
  id       Int    @id @default(autoincrement())
  fullName String
  email    String @unique
  password String
  role     Role   @default(EMPLOYEE)

  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  departmentId      Int?
  department        Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  managedDepartment Department? @relation("DepartmentManager")

  positionId Int?
  position   Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  profile Profile?
  status  Status   @default(ACTIVE)

  posts     Post[]
  comments  Comment[]
  reactions Reaction[]

  postMentions    PostMention[]    @relation("PostMentionedUser")
  commentMentions CommentMention[] @relation("CommentMentionedUser")

  createdGroups   Group[]         @relation("GroupCreator")
  groupMembers    GroupMember[]
  searchHistories     SearchHistory[]
  chatSearchHistories ChatSearchHistory[] @relation("ChatSearchHistoryOwner")
  chatSearchTargets   ChatSearchHistory[] @relation("ChatSearchHistoryTarget")

  createdConversations Conversation[]       @relation("ConversationCreator")
  conversationMembers  ConversationMember[]
  sentMessages         Message[]
  pollVotes            PollVote[]
  eventAttendances     EventAttendee[]
  savedPosts           SavedPost[]

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SearchHistory {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  query      String   @db.VarChar(255)
  searchedAt DateTime @default(now()) @map("searched_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, query])
  @@index([userId, searchedAt])
  @@map("search_histories")
}

model ChatSearchHistory {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  targetUserId Int      @map("target_user_id")
  searchedAt   DateTime @default(now()) @map("searched_at")

  user       User @relation("ChatSearchHistoryOwner", fields: [userId], references: [id], onDelete: Cascade)
  targetUser User @relation("ChatSearchHistoryTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([userId, targetUserId])
  @@index([userId, searchedAt])
  @@map("chat_search_histories")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @db.Text
  expiresAt DateTime
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Department {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  users User[] @relation("DepartmentMembers")

  managerId Int?  @unique
  manager   User? @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)

  groups Group[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Position {
  id        Int      @id @default(autoincrement())
  name      String
  level     Int
  user      User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  phone     String?
  gender    String?
  birthdate DateTime?
  address   String?
  avatarKey String?   @map("avatar_key")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Group {
  id          Int         @id @default(autoincrement()) @map("group_id")
  groupName   String      @map("group_name")
  description String?     @db.Text
  groupType   GroupType   @default(PUBLIC) @map("group_type")
  createdBy   Int         @map("created_by")
  status      GroupStatus @default(ACTIVE)

  creator User          @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  posts   Post[]
  members GroupMember[]

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  coverKey String? @map("cover_key")

  isHidden             Boolean         @default(false) @map("is_hidden")
  joinApprovalPolicy   GroupPermission @default(ADMIN_ONLY) @map("join_approval_policy")
  allowAnonymousJoin   Boolean         @default(false) @map("allow_anonymous_join")
  postPermission       GroupPermission @default(ANY_MEMBER) @map("post_permission")
  postApprovalRequired Boolean         @default(false) @map("post_approval_required")

  notifications Notification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([departmentId])
  @@index([createdBy])
  @@map("groups")
}

model GroupMember {
  id         Int             @id @default(autoincrement()) @map("group_member_id")
  groupId    Int             @map("group_id")
  userId     Int             @map("user_id")
  memberRole GroupMemberRole @default(MEMBER) @map("member_role")
  joinedAt   DateTime        @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  status GroupMemberStatus @default(ACTIVE)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("group_members")
}

model Post {
  id            Int               @id @default(autoincrement()) @map("post_id")
  userId        Int               @map("user_id")
  groupId       Int?              @map("group_id")
  content       String            @db.Text
  contentFormat PostContentFormat @default(PLAIN) @map("content_format")
  visibility    PostVisibility    @default(PUBLIC)
  viewCount     Int               @default(0) @map("view_count")
  isPinned      Boolean           @default(false) @map("is_pinned")
  status        PostStatus        @default(ACTIVE)
  isAnonymous   Boolean           @default(false) @map("is_anonymous")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  comments      Comment[]
  attachments   PostAttachment[]
  reactions     Reaction[]
  mentions      PostMention[]
  notifications Notification[]
  poll          Poll?
  event         Event?
  savedBy       SavedPost[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([groupId])
  @@map("posts")
}

model Event {
  id          Int      @id @default(autoincrement()) @map("event_id")
  postId       Int      @unique @map("post_id")
  title       String   @db.VarChar(200)
  description String?  @db.VarChar(1000)
  startAt     DateTime @map("start_at")
  endAt       DateTime? @map("end_at")
  location    String?  @db.VarChar(255)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  attendees EventAttendee[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([startAt])
  @@map("events")
}

model EventAttendee {
  id      Int                   @id @default(autoincrement()) @map("event_attendee_id")
  eventId Int                   @map("event_id")
  userId  Int                   @map("user_id")
  status  EventAttendanceStatus @default(GOING)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  respondedAt DateTime @default(now()) @map("responded_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
  @@map("event_attendees")
}

model SavedPost {
  id     Int @id @default(autoincrement()) @map("saved_post_id")
  userId Int @map("user_id")
  postId Int @map("post_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  savedAt DateTime @default(now()) @map("saved_at")

  @@unique([userId, postId])
  @@index([userId, savedAt])
  @@index([postId])
  @@map("saved_posts")
}

model Comment {
  id              Int           @id @default(autoincrement()) @map("comment_id")
  postId          Int           @map("post_id")
  userId          Int           @map("user_id")
  parentCommentId Int?          @map("parent_comment_id")
  content         String        @db.Text
  status          CommentStatus @default(ACTIVE)
  isAnonymous     Boolean       @default(false) @map("is_anonymous")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentComment Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies       Comment[] @relation("CommentReplies")

  reactions     Reaction[]
  mentions      CommentMention[]
  notifications Notification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([postId])
  @@index([userId])
  @@index([parentCommentId])
  @@map("comments")
}

model PostMention {
  id              Int @id @default(autoincrement()) @map("mention_id")
  postId          Int @map("post_id")
  mentionedUserId Int @map("mentioned_user_id")

  post          Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  mentionedUser User @relation("PostMentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([postId, mentionedUserId])
  @@index([postId])
  @@index([mentionedUserId])
  @@map("post_mentions")
}

model CommentMention {
  id              Int @id @default(autoincrement()) @map("mention_id")
  commentId       Int @map("comment_id")
  mentionedUserId Int @map("mentioned_user_id")

  comment       Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User    @relation("CommentMentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([commentId, mentionedUserId])
  @@index([commentId])
  @@index([mentionedUserId])
  @@map("comment_mentions")
}

model PostAttachment {
  id             Int            @id @default(autoincrement()) @map("attachment_id")
  postId         Int?           @map("post_id")
  fileName       String         @map("file_name")
  fileKey        String         @map("file_key")
  mimeType       String         @map("mime_type")
  fileSize       Int            @map("file_size")
  attachmentType AttachmentType @map("attachment_type")
  status         MediaStatus    @default(PENDING)
  uploadedById   Int?           @map("uploaded_by_id")

  uploadedAt DateTime @default(now()) @map("uploaded_at")
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_attachments")
}

model Reaction {
  id           Int          @id @default(autoincrement()) @map("reaction_id")
  userId       Int          @map("user_id")
  postId       Int?         @map("post_id")
  commentId    Int?         @map("comment_id")
  reactionType ReactionType @map("reaction_type")
  createdAt    DateTime     @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([userId])
  @@index([postId])
  @@index([commentId])
  @@map("reactions")
}

model Conversation {
  id            Int              @id @default(autoincrement()) @map("conversation_id")
  type          ConversationType @default(DIRECT)
  name          String?          @db.VarChar(255)
  avatarKey     String?          @map("avatar_key")
  createdById   Int?             @map("created_by_id")
  lastMessageAt DateTime?        @map("last_message_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  createdBy User?                @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   ConversationMember[]
  messages  Message[]

  @@index([lastMessageAt])
  @@index([createdById])
  @@map("conversations")
}

model ConversationMember {
  id             Int                    @id @default(autoincrement()) @map("conversation_member_id")
  conversationId Int                    @map("conversation_id")
  userId         Int                    @map("user_id")
  role           ConversationMemberRole @default(MEMBER)
  joinedAt       DateTime               @default(now()) @map("joined_at")
  lastReadAt     DateTime?              @map("last_read_at")
  isMuted        Boolean                @default(false) @map("is_muted")
  leftAt         DateTime?              @map("left_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             Int                @id @default(autoincrement()) @map("message_id")
  conversationId Int                @map("conversation_id")
  senderId       Int                @map("sender_id")
  contentType    MessageContentType @default(TEXT) @map("content_type")
  content        String             @db.Text
  status         MessageStatus      @default(ACTIVE)
  editedAt       DateTime?          @map("edited_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]
  poll         Poll?

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model MessageAttachment {
  id             Int            @id @default(autoincrement()) @map("attachment_id")
  messageId      Int?           @map("message_id")
  fileName       String         @map("file_name")
  fileKey        String         @map("file_key")
  mimeType       String         @map("mime_type")
  fileSize       Int            @map("file_size")
  attachmentType AttachmentType @map("attachment_type")
  status         MediaStatus    @default(PENDING)
  uploadedById   Int?           @map("uploaded_by_id")
  uploadedAt     DateTime       @default(now()) @map("uploaded_at")

  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

model Notification {
  id          Int              @id @default(autoincrement()) @map("notification_id")
  recipientId Int              @map("recipient_id")
  actorId     Int?             @map("actor_id")
  type        NotificationType
  postId      Int?             @map("post_id")
  commentId   Int?             @map("comment_id")
  groupId     Int?             @map("group_id")
  metadata    Json? 
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  recipient User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@map("notifications")
}

model Poll {
  id            Int        @id @default(autoincrement()) @map("poll_id")
  question      String     @db.VarChar(500)
  allowMultiple Boolean    @default(false) @map("allow_multiple")
  endsAt        DateTime?  @map("ends_at")
  status        PollStatus @default(ACTIVE)

  postId    Int? @unique @map("post_id")
  messageId Int? @unique @map("message_id")

  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  options PollOption[]
  votes   PollVote[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([postId])
  @@index([messageId])
  @@map("polls")
}

model PollOption {
  id        Int    @id @default(autoincrement()) @map("poll_option_id")
  pollId    Int    @map("poll_id")
  label     String @db.VarChar(200)
  sortOrder Int    @default(0) @map("sort_order")

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id       Int @id @default(autoincrement()) @map("poll_vote_id")
  pollId   Int @map("poll_id")
  optionId Int @map("option_id")
  userId   Int @map("user_id")

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId, optionId])
  @@index([pollId])
  @@index([optionId])
  @@index([userId])
  @@map("poll_votes")
}
