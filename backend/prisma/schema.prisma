generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum Status {
  ACTIVE
  INACTIVE
}

model User {
  id           Int            @id @default(autoincrement())
  fullName     String
  email        String         @unique
  password     String
  role         Role           @default(EMPLOYEE)
  avatarUrl    String?
  refreshTokens RefreshToken[]
  departmentId Int?
  department    Department?    @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  managedDepartment Department? @relation("DepartmentManager")
  positionId   Int?
  position     Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  profile      Profile?
  status       Status       @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @db.Text
  expiresAt DateTime
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  description String?
  users       User[]   @relation("DepartmentMembers")
  managerId Int? @unique
  manager     User?    @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Position {
  id          Int      @id @default(autoincrement())
  name       String   
  level Int
  user User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Profile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  phone    String?
  gender  String?
  birthdate DateTime?
  address String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}